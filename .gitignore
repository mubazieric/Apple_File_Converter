ios/Runner.xcodeproj/xcuserdata/
ios/Runner.xcodeproj/project.xcworkspace/xcuserdata/
*.ipa
*.dSYM.zip
*.xcarchive

# ---------------------------------------------------------------------------
# IDE / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Secrets — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.secret
*.pem
service-account*.json
google-services.json
# NOTE: android/app/google-services.json is required for an AdMob-enabled release
# build but must be provisioned by the release engineer, not committed here.
